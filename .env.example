# ==============================================================================
# Konfigurasi Aplikasi PHP (Salin menjadi .env dan sesuaikan nilai sebelum pakai)
# ==============================================================================

# Lingkungan aplikasi: development | staging | production
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Konfigurasi Database
# Driver didukung: sqlite (default lokal/Codespaces) | mysql | pgsql
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_SQLITE_PATH=database.sqlite
DB_SCHEMA_PATH=database.sql

# Diisi bila DB_CONNECTION=mysql atau pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=author_studio
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# Konfigurasi Session & Keamanan Cookie
# ------------------------------------------------------------------------------
SESSION_NAME=AUTHOR_STUDIO_SESSID
# Durasi masa berlaku cookie sesi dalam detik (contoh: 86400 = 24 jam)
SESSION_LIFETIME=86400
# Atur ke true bila aplikasi berjalan penuh di atas HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
# Opsi SameSite: Lax | Strict | None
SESSION_COOKIE_SAMESITE=Lax
SESSION_USE_STRICT_MODE=true

# Kunci rahasia aplikasi untuk token/HMAC tambahan (ganti dengan string acak panjang)
APP_KEY=change-this-to-a-long-random-secret-key
